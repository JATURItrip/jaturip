# ===== 의존성 =====
# package.json + package-lock.json만 커밋하면
# npm install로 그대로 복원된다.
node_modules/


# ===== 환경 변수 / 비밀키 =====
# TOUR_API_KEY, KAKAO_REST_KEY가 들어 있으므로
# 절대 커밋하지 않는다.
.env
.env.*
!.env.example


# ===== 로그 =====
*.log
npm-debug.log*
logs/


# ===== OS =====
.DS_Store
Thumbs.db


# ===== 에디터 =====
.vscode/
.idea/
*.swp


# ===== 빌드 산출물 =====
dist/
build/
coverage/


